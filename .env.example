# Copy to .env and configure the published API groups. Never commit real secrets.
XANO_AUTH_URL=https://YOUR-INSTANCE.xano.io/api:AUTH-CANONICAL
XANO_BASE_URL=https://YOUR-INSTANCE.xano.io/api:LEGACY-CANONICAL
XANO_SOCIAL_URL=https://YOUR-INSTANCE.xano.io/api:codeboxd
TMDB_READ_TOKEN=
# Optional server-side DeepL translation of anime/book descriptions (PT-BR).
DEEPL_API_KEY=
# Recovery email: private SendGrid configuration, also required in Xano.
SENDGRID_API_KEY=
# Email address of a verified SendGrid sender (without display name).
SENDGRID_FROM=
# Enable when serving through HTTPS in production.
COOKIE_SECURE=false
# Enable only after the new GET /library contract is published and validated.
LIBRARY_PAGINATION_ENABLED=false
# Enable only after default_key schema/endpoints and reviewed legacy backfill are validated.
DEFAULT_LIST_IDENTITY_ENABLED=false
# Server-side Cloudinary credentials. Never expose API_SECRET in the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Keep false until external-image post contracts and lifecycle are integrated.
CLOUDINARY_UPLOADS_ENABLED=false
